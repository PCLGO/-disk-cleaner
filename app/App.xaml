<Application x:Class="DiskCleanupAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E8EEF9" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
        </Style>
    </Application.Resources>
</Application>
